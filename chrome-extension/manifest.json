{
  "manifest_version": 3,
  "name": "Auto Scroll & Skip Videos",
  "version": "1.0.0",
  "description": "Automatically scrolls pages, skips videos, and navigates through paginated content",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Scroll & Skip Videos"
  },
  "options_page": "options.html",
  "author": "Code Swami",
  "homepage_url": "https://github.com"
}


